[Unit]
Description=FastMM BTCUSDT public market data and dry-run quotes
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=fastmm
Group=fastmm
WorkingDirectory=/var/lib/fastmm/paper
ExecCondition=/usr/bin/test ! -e /var/lib/fastmm/paper/PAUSED
ExecStart=/opt/fastmm/bin/fastmm-live --config /opt/fastmm/etc/btcusdt.toml --dry-run
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGINT
MemoryMax=650M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fastmm/paper /dev/shm
PrivateTmp=true
UMask=0027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
