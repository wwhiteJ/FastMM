{
  "schema_version": 1,
  "protocol_id": "fastmm-order-retention-calibration-v1",
  "artifact_type": "research_protocol_not_runtime_config",
  "status": "specified_not_fitted",
  "specification": "../order_retention_v1.md",
  "baseline": {
    "fastmm_commit": "2500ac16b2bf5621750f7a1b1d4475c6aa90f330",
    "config_repo_path": "deploy/paper/btcusdt.toml",
    "config_sha256": "b28ac2244c827c588dd47a1735d794715407a4f6349f34a9a43a35f60e11d9fb",
    "new_implementation_must_reproduce_off_and_observe": true
  },
  "feature_contract": {
    "order": "journal_engine_consumption_sequence",
    "clock": "reconstructed_ctx_now",
    "window_boundary": "(t-w,t]",
    "trade_weight": "quantity_BTC",
    "snapshot_interval_ms": 100,
    "snapshot_weight": "equal_time_both_sides_common_valid_rows",
    "zero_trade_volume_signal": 0,
    "positive_quantity_bbo_required": true,
    "deduplicate_trade_id": true,
    "future_features_forbidden": true
  },
  "policy": {
    "side_sign": {"buy": 1, "sell": -1},
    "x": "-side_sign * normalized_aggressive_trade_volume_imbalance",
    "y": "-side_sign * normalized_best_bid_ask_quantity_imbalance",
    "block": "valid && x > 0 && y > 0 && x >= a && y >= b",
    "shared_thresholds_for_sides": true,
    "release": "condition_false_then_existing_OMS_constraints",
    "volume_floor": "absent",
    "additional_cooldown": "absent",
    "separate_release_threshold": "absent",
    "inventory_risk_rules": "unchanged_and_prioritized",
    "threshold_storage": "reduced_exact_rational",
    "window_storage": "integer_nanoseconds"
  },
  "candidate_generation": {
    "fit_partition": "train_only",
    "window_rule": "double_existing_100ms_timer_until_existing_60000ms_hard_exit_then_append_cap",
    "window_ms": [100, 200, 400, 800, 1600, 3200, 6400, 12800, 25600, 51200, 60000],
    "positive_sample_quantile_ranks": [0.5, 0.75, 0.9],
    "quantile_method": "sorted_one_based_ceil_p_times_n",
    "include_zero_threshold": true,
    "deduplicate_thresholds": true,
    "maximum_joint_candidates": 176,
    "grid_refinement": "forbidden_in_this_protocol",
    "window_and_quantile_grid_evidence_class": "declared_research_search_resolution_not_profitable_parameters"
  },
  "selection": {
    "objective": "minimum_leave_one_UTC_day_out_mean_hourly_net_pnl_improvement_vs_B0",
    "all_training_and_neighbor_deltas_must_be_positive": true,
    "risk_noninferiority_required": true,
    "selected_joint_candidates": 1,
    "tie_breakers": ["higher_filled_notional", "fewer_cancel_requests", "ascending_canonical_parameter_id"],
    "validation_neighbor_role": "stability_check_never_replacement",
    "validation_failure": "end_experiment_no_runner_up_retry",
    "ablation_roles": ["trade_only_at_selected_w_and_a", "book_only_at_selected_b"],
    "ablation_role": "diagnostic_never_replacement"
  },
  "split_design": {
    "calendar": "UTC",
    "train_complete_days": 7,
    "validation_complete_days": 7,
    "test_minimum_complete_days": 14,
    "dates_status": "must_be_registered_in_run_locks_not_yet_assigned",
    "test_start": "future_UTC_midnight_after_final_lock",
    "already_inspected_303_fill_session": "engineering_regression_only",
    "initial_state_each_partition": "flat_no_orders_after_market_only_warmup",
    "intra_partition_resets": "forbidden_including_journal_rollover",
    "warmup_ms": 60000,
    "terminal_no_new_risk_seconds": 70,
    "terminal_time_and_costs_counted": true,
    "terminal_residual_position": "incomplete_exit_no_pass",
    "global_loss_stop": "risk_budget_exhausted_no_reset_no_power_from_post_stop_zero_returns"
  },
  "random_control": {
    "fit_partition": "train_only",
    "sample_unit": "complete_clear_duration_next_blocked_side_block_duration_tuple",
    "sampling": "uniform_with_replacement",
    "seeds": 20,
    "initial_gate_state": "clear",
    "condition_on_test_market": false,
    "comparator": "mean_across_all_preregistered_seeds",
    "uncertainty": "paired_time_resampling_and_random_seed_resampling"
  },
  "statistical_design": {
    "observation_unit": "hourly_equity_increment_no_position_reset",
    "primary_metric": "mean_hourly_pnl_gate_minus_B0_USDT",
    "block_selector": "arch.bootstrap.optimal_block_length_stationary",
    "arch_version": "8.0.0",
    "block_fit_partition": "validation_only",
    "block_selector_series": ["gate_minus_B0", "gate_net", "gate_minus_mean_random"],
    "base_block_hours": "max(24,ceil(max_finite_stationary_estimates))",
    "block_multipliers": [1, 2],
    "invalid_block_estimate": "insufficient_data_if_degenerate_or_2b_ge_validation_hours",
    "bootstrap": "paired_stationary_with_circular_continuation",
    "replications": 10000,
    "confidence_interval": "percentile_0.025_0.975",
    "confidence_level": 0.95,
    "planning_power": 0.8,
    "long_run_variance": "max(n*variance_of_bootstrap_mean_delta_at_b,n*variance_of_bootstrap_mean_delta_at_2b)",
    "economic_effect": "minus_validation_mean_B0_net_hourly_pnl_when_positive",
    "nonpositive_economic_effect": "economic_target_changed_no_invented_replacement",
    "required_hours": "ceil((normal_quantile(0.975)+normal_quantile(0.8))^2*long_run_variance/economic_effect^2)",
    "test_days": "ceil(max(336,required_hours)/24)",
    "planning_formula_scope": "approximation_not_guaranteed_sufficiency",
    "early_stop_for_significance": false,
    "test_dependence_check": "inconclusive_if_test_selector_exceeds_2b_or_is_degenerate_never_reselect_narrower_interval"
  },
  "risk_noninferiority": {
    "comparator": "same_partition_same_scenario_B0",
    "maximum_equity_drawdown": "gate_le_B0",
    "worst_closed_episode_loss": "gate_le_B0",
    "absolute_position_time_integral": "gate_le_B0",
    "risk_limit_or_exit_regression": "invalid_engineering_result"
  },
  "cost_and_fill_scenarios": [
    {"id": "S0", "maker_fee_bps": 1.8, "taker_fee_bps": 4.5, "entry_ms": 5, "cancel_ms": 5, "response_ms": 5, "queue_conservatism": 1.0},
    {"id": "S1", "inherits": "S0", "entry_ms": 10, "cancel_ms": 10, "response_ms": 10},
    {"id": "S2", "inherits": "S0", "entry_ms": 20, "cancel_ms": 20, "response_ms": 20},
    {"id": "S3", "inherits": "S0", "entry_ms": 50, "cancel_ms": 50, "response_ms": 50},
    {"id": "S4", "inherits": "S0", "queue_conservatism": 0.5},
    {"id": "S5", "inherits": "S0", "maker_fee_bps": 2.0, "taker_fee_bps": 5.0}
  ],
  "scenario_contract": {
    "evidence_class": "simulation_assumptions_not_measured_account_or_order_latency",
    "jitter": "unchanged_from_pinned_baseline",
    "market_data_arrival": "recorded",
    "both_policies_rerun": true,
    "cartesian_product": false,
    "unknown_override_keys": "error",
    "effective_engine_values_must_be_emitted": true
  },
  "randomness": {
    "generator": "numpy.random.PCG64",
    "seed_hash_input_utf8_newline_separated": ["protocol_sha256", "train_manifest_sha256", "phase", "role", "ordinal_base10"],
    "seed": "first_8_bytes_sha256_big_endian_unsigned",
    "use_future_test_data_hash_for_seed": false,
    "dependency_versions": "freeze_in_run_lock_before_execution"
  },
  "paper_promotion_requires": [
    "primary_delta_lower_bound_positive_for_b_and_2b",
    "gate_minus_mean_random_lower_bound_positive_for_b_and_2b",
    "gate_own_net_lower_bound_positive_for_b_and_2b",
    "nonzero_simulated_trading",
    "all_engineering_invariants_pass",
    "risk_noninferiority_pass",
    "leave_any_one_day_out_delta_positive",
    "all_preregistered_neighbors_have_positive_delta_point_estimate",
    "all_cost_fill_scenarios_have_positive_delta_and_nonnegative_gate_net_point_estimates"
  ],
  "required_run_artifacts": [
    "dataset_manifest.json",
    "features",
    "candidates.jsonl",
    "train_scores.csv",
    "validation_report.json",
    "test_lock.json",
    "test_report.json",
    "calibration_result.json"
  ],
  "result_statuses": [
    "data_invalid",
    "engineering_invalid",
    "incomplete_exit",
    "risk_budget_exhausted",
    "insufficient_signal_support",
    "insufficient_data",
    "no_candidate",
    "economic_target_changed",
    "validation_failed",
    "no_improvement",
    "inconclusive",
    "improved_only",
    "parameter_unstable",
    "model_sensitive",
    "paper_eligible"
  ],
  "fitted_parameters": null,
  "execution_results": null,
  "production_changed": false
}
